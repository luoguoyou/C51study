  29   1          LED_G = 1;
  30   1          LED_B = 1;
  31   1       }
  32           void Uart1_SendByte(unsigned char dat)
  33          {
  34   1          SBUF = dat;
  35   1          while (!TI);        // 等待发送完成
  36   1          TI = 0;             // 清除发送中断标志
  37   1      }
  38          
  39          void Uart1_ISR(void) interrupt 4
  40          {
  41   1          if (RI)
